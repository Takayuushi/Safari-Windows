<Window x:Class="SafariApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Safari" Height="860" Width="1320" MinHeight="520" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#18181a"
        Foreground="#f5f5f7"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        FontSize="13">

    <!-- Seamless borderless window with native Windows snap & aero drag -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="0" CornerRadius="10" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Icon button style -->
        <Style x:Key="ChromeIconBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1a6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333338" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Traffic light buttons -->
        <Style x:Key="TrafficLightBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Safari Chrome (Toolbar + Tab Bar) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Viewport (Sidebar + Web Content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP CHROME -->
        <Border Grid.Row="0" Background="#222225" BorderBrush="#333338" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                
                <!-- Toolbar Row (52px) -->
                <Grid Height="52" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Traffic Lights & Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- macOS Traffic Lights -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Button x:Name="BtnClose" Style="{StaticResource TrafficLightBtn}" Background="#ff5f56" Margin="0,0,8,0" Click="BtnClose_Click" ToolTip="Close" />
                            <Button x:Name="BtnMin" Style="{StaticResource TrafficLightBtn}" Background="#ffbd2e" Margin="0,0,8,0" Click="BtnMin_Click" ToolTip="Minimize" />
                            <Button x:Name="BtnMax" Style="{StaticResource TrafficLightBtn}" Background="#27c93f" Margin="0,0,12,0" Click="BtnMax_Click" ToolTip="Zoom / Maximize" />
                        </StackPanel>

                        <!-- Sidebar Toggle Button -->
                        <Button x:Name="BtnSidebar" Style="{StaticResource ChromeIconBtn}" Margin="0,0,6,0" Click="BtnSidebar_Click" ToolTip="Toggle Sidebar">
                            <Path Data="M3,4 H21 A3,3 0 0 1 24,7 V17 A3,3 0 0 1 21,20 H3 A3,3 0 0 1 0,17 V7 A3,3 0 0 1 3,4 Z M8,5 V19" 
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="17" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Back / Forward Navigation -->
                        <Border Background="#1b1b1e" CornerRadius="8" Padding="2" BorderBrush="#2e2e33" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBack" Style="{StaticResource ChromeIconBtn}" Width="28" Height="28" Click="BtnBack_Click" ToolTip="Back">
                                    <Path Data="M15,18 L9,12 L15,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="BtnForward" Style="{StaticResource ChromeIconBtn}" Width="28" Height="28" Click="BtnForward_Click" ToolTip="Forward">
                                    <Path Data="M9,18 L15,12 L9,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Unified Smart Search Field (Safari Address Bar) -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" MaxWidth="680" MinWidth="340" Width="520" Margin="14,0,14,0" VerticalAlignment="Center">
                        <Border x:Name="AddressPillBorder" Background="#2c2c30" CornerRadius="9" BorderBrush="#3c3c43" BorderThickness="1" Height="34" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Text Size / Reader Format Icon (aA) -->
                                <TextBlock Grid.Column="0" Text="aA" Foreground="#8e8e93" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip="Page Format &amp; Settings" />

                                <!-- SSL Security Padlock Icon -->
                                <Path Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Data="M4,10 V6 A4,4 0 0 1 12,6 V10 M3,10 H13 V18 H3 Z" 
                                      Stroke="#8e8e93" StrokeThickness="1.5" Width="11" Height="13" Stretch="Uniform" />

                                <!-- URL / Search Text Box -->
                                <TextBox x:Name="TxtAddress" Grid.Column="2" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Foreground="#f5f5f7"
                                         FontSize="12.5" Text="Start Page" KeyDown="TxtAddress_KeyDown"
                                         GotFocus="TxtAddress_GotFocus" LostFocus="TxtAddress_LostFocus" />

                                <!-- Reload Button -->
                                <Button x:Name="BtnReload" Grid.Column="3" Style="{StaticResource ChromeIconBtn}" Width="26" Height="26" Click="BtnReload_Click" ToolTip="Reload (Ctrl+R)">
                                    <Path Data="M18,11 A7,7 0 1 0 16.5,15.5 M18,5 V11 H12" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Group: Downloads, Share, New Tab, Overview -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Downloads Button (opens mini popup) -->
                        <Button x:Name="BtnDownloads" Style="{StaticResource ChromeIconBtn}" Click="BtnDownloads_Click" ToolTip="Downloads">
                            <Grid>
                                <Path Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 Z M12,7 V15 M8.5,11.5 L12,15 L15.5,11.5" 
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" />
                                <!-- Download Active Indicator Badge -->
                                <Ellipse x:Name="DownloadBadge" Width="6" Height="6" Fill="#2997ff" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="BtnShare" Style="{StaticResource ChromeIconBtn}" Click="BtnShare_Click" ToolTip="Share">
                            <Path Data="M4,12 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V12 M12,3 V15 M7.5,7.5 L12,3 L16.5,7.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnNewTab" Style="{StaticResource ChromeIconBtn}" Click="BtnNewTab_Click" ToolTip="New Tab (Ctrl+T)">
                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnOverview" Style="{StaticResource ChromeIconBtn}" Click="BtnOverview_Click" ToolTip="Tab Overview (Ctrl+Shift+\)">
                            <Path Data="M7,7 H19 V19 H7 Z M4,17 V6 A2,2 0 0 1 6,4 H17" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Safari Separate Tab Bar Row (Sleek Apple Safari style) -->
                <Border x:Name="TabBarRow" Height="38" Padding="12,0,12,6" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>

                        <!-- Plus Button at end of tab bar -->
                        <Button Grid.Column="1" Style="{StaticResource ChromeIconBtn}" Width="28" Height="28" Margin="4,0,0,0" Click="BtnNewTab_Click" ToolTip="New Tab">
                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN VIEWPORT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Authentic Safari Sidebar -->
                <ColumnDefinition x:Name="ColSidebar" Width="0" />
                <!-- Column 1: Web Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Sidebar (Safari 3-segment switcher: Bookmarks, Reading List, History) -->
            <Border Grid.Column="0" Background="#1c1c1f" BorderBrush="#2e2e33" BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,12">
                    <Grid.RowDefinitions>
                        <!-- Row 0: 3-Segment Switcher -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Search Box -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Secondary Toolbar (e.g. "Clear History..." link) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Items List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segmented Switcher (Bookmarks / Reading List / History) -->
                    <Border Grid.Row="0" Background="#28282d" CornerRadius="8" Padding="2" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Segment 0: Bookmarks (Ribbon / Bookmark Icon) -->
                            <Button x:Name="BtnSegmentBookmarks" Grid.Column="0" Click="BtnSegment_Click" Tag="Bookmarks"
                                    Background="#383840" BorderThickness="0" Height="28" Cursor="Hand" ToolTip="Bookmarks">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="segBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="M5,4 H15 V20 L10,16 L5,20 Z" 
                                                  Stroke="#f5f5f7" StrokeThickness="1.6" Width="13" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Segment 1: Reading List (Eyeglasses Icon) -->
                            <Button x:Name="BtnSegmentReadingList" Grid.Column="1" Click="BtnSegment_Click" Tag="ReadingList"
                                    Background="Transparent" BorderThickness="0" Height="28" Cursor="Hand" ToolTip="Reading List">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="segBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="M4,10 A4,4 0 1 0 12,10 A4,4 0 1 0 4,10 M12,10 H14 M14,10 A4,4 0 1 0 22,10 A4,4 0 1 0 14,10" 
                                                  Stroke="#a1a1a6" StrokeThickness="1.6" Width="18" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Segment 2: History (Clock Icon) -->
                            <Button x:Name="BtnSegmentHistory" Grid.Column="2" Click="BtnSegment_Click" Tag="History"
                                    Background="Transparent" BorderThickness="0" Height="28" Cursor="Hand" ToolTip="History">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="segBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Path Data="M12,3 A9,9 0 1 0 21,12 A9,9 0 0 0 12,3 Z M12,7 V12 L16,14" 
                                                  Stroke="#a1a1a6" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search Box -->
                    <Border Grid.Row="1" Background="#26262b" CornerRadius="7" BorderBrush="#36363d" BorderThickness="1" Height="28" Margin="0,0,0,10">
                        <Grid Margin="8,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M10,10 L14,14 M6,10 A4,4 0 1 1 10,6 A4,4 0 0 1 6,10 Z"
                                  Stroke="#8e8e93" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtSidebarSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="#f5f5f7" FontSize="12" VerticalAlignment="Center" TextChanged="TxtSidebarSearch_TextChanged" />
                            <TextBlock x:Name="TxtSidebarSearchPlaceholder" Grid.Column="1" Text="Search" Foreground="#707076"
                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <!-- History action (Clear History...) -->
                    <Grid Grid.Row="2" x:Name="HistoryActionRow" Visibility="Collapsed" Margin="2,0,2,8">
                        <Button x:Name="BtnClearHistory" Content="Clear History…" Background="Transparent" BorderThickness="0"
                                Foreground="#2997ff" Cursor="Hand" FontSize="12" HorizontalAlignment="Left" Click="BtnClearHistory_Click" />
                    </Grid>

                    <!-- Sidebar List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarItemsPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Web Browser Area -->
            <Grid Grid.Column="1" Background="#18181a">
                <wv2:WebView2 x:Name="WebBrowser" 
                              NavigationStarting="WebBrowser_NavigationStarting" 
                              NavigationCompleted="WebBrowser_NavigationCompleted" 
                              SourceChanged="WebBrowser_SourceChanged" />
            </Grid>
        </Grid>

        <!-- DOWNLOADS POPOVER (Floating macOS-style mini panel) -->
        <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=BtnDownloads}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" VerticalOffset="8" HorizontalOffset="-240">
            <Border Width="340" MaxHeight="420" Background="#26262a" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Popover Header: Title and Clear button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="13.5" Foreground="#f5f5f7" VerticalAlignment="Center" />
                        <Button x:Name="BtnClearDownloads" Content="Clear" HorizontalAlignment="Right" Background="Transparent" Foreground="#2997ff"
                                BorderThickness="0" Cursor="Hand" FontSize="12" Click="BtnClearDownloads_Click" />
                    </Grid>

                    <!-- Scrollable list of downloads -->
                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DownloadsListPanel">
                            <TextBlock x:Name="TxtNoDownloads" Text="No recent downloads" Foreground="#8e8e93" FontSize="12" HorizontalAlignment="Center" Margin="0,24,0,24" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Popover Footer: Open Downloads Folder -->
                    <Border Grid.Row="2" BorderBrush="#35353b" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <Button x:Name="BtnOpenDownloadsFolder" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnOpenDownloadsFolder_Click" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,4 H10 L12,6 H21 V18 H3 Z" Stroke="#a1a1a6" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Downloads Folder" Foreground="#a1a1a6" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
