<Window x:Class="SafariApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Safari" Height="840" Width="1280" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#18181a"
        Foreground="#f5f5f7"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        FontSize="13">

    <!-- WindowChrome for seamless borderless window with native Windows snap & aero drag -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="0" CornerRadius="10" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Button styles -->
        <Style x:Key="ChromeIconBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1a6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333338" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrafficLightBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Safari Chrome (Toolbar + Tab Bar) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Viewport (Sidebar + WebView2) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP CHROME -->
        <Border Grid.Row="0" Background="#222225" BorderBrush="#333338" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                
                <!-- Toolbar Row (52px) -->
                <Grid Height="52" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Group: Traffic Lights & Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- macOS Traffic Lights -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Button x:Name="BtnClose" Style="{StaticResource TrafficLightBtn}" Background="#ff5f56" Margin="0,0,8,0" Click="BtnClose_Click" ToolTip="Close" />
                            <Button x:Name="BtnMin" Style="{StaticResource TrafficLightBtn}" Background="#ffbd2e" Margin="0,0,8,0" Click="BtnMin_Click" ToolTip="Minimize" />
                            <Button x:Name="BtnMax" Style="{StaticResource TrafficLightBtn}" Background="#27c93f" Margin="0,0,10,0" Click="BtnMax_Click" ToolTip="Zoom / Maximize" />
                        </StackPanel>

                        <!-- Sidebar Toggle Button -->
                        <Button x:Name="BtnSidebar" Style="{StaticResource ChromeIconBtn}" Margin="0,0,6,0" Click="BtnSidebar_Click" ToolTip="Toggle Sidebar">
                            <Path Data="M3,4 H21 A3,3 0 0 1 24,7 V17 A3,3 0 0 1 21,20 H3 A3,3 0 0 1 0,17 V7 A3,3 0 0 1 3,4 Z M8,5 V19" 
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="17" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Back / Forward Navigation -->
                        <Border Background="#1b1b1e" CornerRadius="8" Padding="2" BorderBrush="#2e2e33" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBack" Style="{StaticResource ChromeIconBtn}" Width="28" Height="28" Click="BtnBack_Click" ToolTip="Back">
                                    <Path Data="M15,18 L9,12 L15,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="BtnForward" Style="{StaticResource ChromeIconBtn}" Width="28" Height="28" Click="BtnForward_Click" ToolTip="Forward">
                                    <Path Data="M9,18 L15,12 L9,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Smart Search Field -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" MaxWidth="680" MinWidth="340" Width="520" Margin="14,0,14,0" VerticalAlignment="Center">
                        <Border x:Name="AddressPillBorder" Background="#2d2d31" CornerRadius="9" BorderBrush="#3d3d44" BorderThickness="1" Height="34" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Padlock SSL Icon -->
                                <Path Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Data="M4,10 V6 A4,4 0 0 1 12,6 V10 M3,10 H13 V18 H3 Z" 
                                      Stroke="#a1a1a6" StrokeThickness="1.5" Width="12" Height="14" Stretch="Uniform" />

                                <!-- URL / Search Text Box -->
                                <TextBox x:Name="TxtAddress" Grid.Column="1" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Foreground="#f5f5f7"
                                         FontSize="12.5" Text="google.com" KeyDown="TxtAddress_KeyDown"
                                         GotFocus="TxtAddress_GotFocus" LostFocus="TxtAddress_LostFocus" />

                                <!-- Reload Button -->
                                <Button x:Name="BtnReload" Grid.Column="2" Style="{StaticResource ChromeIconBtn}" Width="26" Height="26" Click="BtnReload_Click" ToolTip="Reload (Ctrl+R)">
                                    <Path Data="M18,11 A7,7 0 1 0 16.5,15.5 M18,5 V11 H12" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Group: Downloads, Share, New Tab, Overview -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnDownloads" Style="{StaticResource ChromeIconBtn}" Click="BtnDownloads_Click" ToolTip="Downloads">
                            <Path Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 Z M12,7 V15 M8.5,11.5 L12,15 L15.5,11.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnShare" Style="{StaticResource ChromeIconBtn}" Click="BtnShare_Click" ToolTip="Share">
                            <Path Data="M4,12 V19 A2,2 0 0 0 6,21 H18 A2,2 0 0 0 20,19 V12 M12,3 V15 M7.5,7.5 L12,3 L16.5,7.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnNewTab" Style="{StaticResource ChromeIconBtn}" Click="BtnNewTab_Click" ToolTip="New Tab (Ctrl+T)">
                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnOverview" Style="{StaticResource ChromeIconBtn}" Click="BtnOverview_Click" ToolTip="Tab Overview (Ctrl+Shift+\)">
                            <Path Data="M7,7 H19 V19 H7 Z M4,17 V6 A2,2 0 0 1 6,4 H17" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tab Bar Row (Shown when tabs >= 2, like Safari) -->
                <Border x:Name="TabBarRow" Height="36" Padding="10,0,10,4" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN VIEWPORT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Collapsible Sidebar -->
                <ColumnDefinition x:Name="ColSidebar" Width="0" />
                <!-- Column 1: Native WebView2 Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Sidebar -->
            <Border Grid.Column="0" Background="#1c1c1f" BorderBrush="#2e2e33" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Bookmarks &amp; History" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Foreground="#f5f5f7" />

                    <ListBox Grid.Row="1" x:Name="LstBookmarks" Background="Transparent" BorderThickness="0" Foreground="#d1d1d6"
                             SelectionChanged="LstBookmarks_SelectionChanged">
                        <ListBoxItem Content="Apple (apple.com)" Tag="https://www.apple.com" />
                        <ListBoxItem Content="Google (google.com)" Tag="https://www.google.com" />
                        <ListBoxItem Content="YouTube (youtube.com)" Tag="https://www.youtube.com" />
                        <ListBoxItem Content="GitHub (github.com)" Tag="https://www.github.com" />
                        <ListBoxItem Content="Wikipedia (wikipedia.org)" Tag="https://www.wikipedia.org" />
                        <ListBoxItem Content="Reddit (reddit.com)" Tag="https://www.reddit.com" />
                    </ListBox>
                </Grid>
            </Border>

            <!-- Real Native Edge / Chromium WebView2 Engine -->
            <Grid Grid.Column="1" Background="#18181a">
                <wv2:WebView2 x:Name="WebBrowser" 
                              NavigationStarting="WebBrowser_NavigationStarting" 
                              NavigationCompleted="WebBrowser_NavigationCompleted" />
            </Grid>
        </Grid>
    </Grid>
</Window>
